(function(){
  var views=[].slice.call(document.querySelectorAll('.view')), tabs=[].slice.call(document.querySelectorAll('.tab'));
  var sel=document.getElementById('pick'), p1=document.getElementById('p1');
  var cur={view:null,card:null};
  function show(v,cardId){
    cur.view=v;
    views.forEach(function(s){s.classList.toggle('on',s.getAttribute('data-view')===v)});
    tabs.forEach(function(t){t.classList.toggle('on',t.getAttribute('data-view')===v)});
    var sec=document.querySelector('.view[data-view="'+v+'"]'); var cards=[].slice.call(sec.querySelectorAll('.card'));
    sel.innerHTML='';
    if(!cards.length){sel.classList.add('hide');p1.classList.add('hide');cur.card=null;return}
    sel.classList.remove('hide');p1.classList.remove('hide');
    if(!cardId||!document.getElementById(cardId)||document.getElementById(cardId).closest('.view')!==sec) cardId=cards[0].id;
    cur.card=cardId;
    cards.forEach(function(c){c.classList.toggle('on',c.id===cardId)});
    [].slice.call(sec.querySelectorAll('tr.pick')).forEach(function(r){r.classList.toggle('sel',r.getAttribute('data-card')===cardId)});
    cards.forEach(function(c){var o=document.createElement('option');o.value=c.id;o.textContent=c.getAttribute('data-name');sel.appendChild(o)});
    sel.value=cardId;
    try{history.replaceState(null,'','#'+cardId)}catch(e){}
  }
  tabs.forEach(function(t){t.addEventListener('click',function(){show(t.getAttribute('data-view'))})});
  sel.addEventListener('change',function(){show(cur.view,sel.value);var c=document.getElementById(sel.value);if(c)c.scrollIntoView({behavior:'smooth',block:'start'})});
  [].slice.call(document.querySelectorAll('tr.pick')).forEach(function(r){r.addEventListener('click',function(e){e.preventDefault();show(r.closest('.view').getAttribute('data-view'),r.getAttribute('data-card'));var c=document.getElementById(r.getAttribute('data-card'));if(c)c.scrollIntoView({behavior:'smooth',block:'start'})})});
  p1.addEventListener('click',function(){document.body.className='print-one';window.print()});
  document.getElementById('p2').addEventListener('click',function(){document.body.className='print-view';window.print()});
  window.addEventListener('afterprint',function(){document.body.className=''});
  var h=(location.hash||'').slice(1); var el=h&&document.getElementById(h);
  if(el&&el.classList.contains('card')) show(el.closest('.view').getAttribute('data-view'),h); else show(tabs[0].getAttribute('data-view'));
  setTimeout(function(){window.scrollTo(0,0)},0);
})();
